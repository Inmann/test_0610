# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 모니터링할 카카오톡 단톡방 이름 (정확히 입력)
KAKAO_ROOM_NAME=IR 단톡방

# 메시지 폴링 주기 (초)
POLL_INTERVAL=15

# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
# 대시보드의 "AI에게 묻기" 채팅 기능에 사용됩니다.
GEMINI_API_KEY=AIzaxxxxxxxx

# 사용할 Gemini 모델 (선택, 기본값: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
